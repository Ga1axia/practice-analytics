# Client (Vite) — safe to expose with RLS SELECT-only policies
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server (/api/ask, /api/bqe/*, seed)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Claude Q&A (Vercel /api/ask only)
ANTHROPIC_API_KEY=

# BQE CORE (server-only — never prefix with VITE_)
# From https://api-developer.bqecore.com → App Details
CORE_CLIENT_ID=
CORE_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Developer Portal.
# Local: use the Vite origin so the oauth cookie and callback share one host
# (Vite proxies /api → vercel dev :3000):
#   http://localhost:5173/api/bqe/callback
# Production (Vercel — same host for SPA + API):
#   https://YOUR_DEPLOYMENT.vercel.app/api/bqe/callback
BQE_REDIRECT_URI=http://localhost:5173/api/bqe/callback
# Where to send the browser after OAuth (the Vite/SPA origin)
BQE_APP_ORIGIN=http://localhost:5173
# Local API port for `npm run dev:api` (Vite proxies /api here)
# API_PORT=8787
# Optional overrides
# BQE_IDENTITY_BASE_URL=https://api-identity.bqecore.com/idp
# BQE_SCOPES=read:core offline_access openid
