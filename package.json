{
  "name": "practice-analytics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "tsx scripts/extract-and-seed.ts",
    "dev:api": "tsx scripts/local-api.ts",
    "test": "tsx --test src/lib/staffingDelivery.test.ts src/lib/scheduleEnsure.test.ts src/lib/scheduleSections.test.ts src/lib/workType.test.ts src/lib/clientCopy.test.ts src/lib/oauthRedirect.test.ts src/lib/efficiencyAnalysis.test.ts",
    "import:time-entries": "tsx scripts/import-time-entries.ts",
    "seed:time-entries-json": "tsx scripts/seed-time-entries-from-json.ts",
    "provision:employees": "node --env-file=.env.local scripts/provision-employees-from-time.mjs",
    "sync:project-members": "node --env-file=.env.local scripts/sync-project-members-from-time.mjs",
    "seed:demo-customers": "node --env-file=.env.local scripts/seed-demo-customers.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-grid-layout": "^2.2.4",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/xlsx": "^0.0.35",
    "@vercel/node": "^5.9.2",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.4.2",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vercel": "^58.7.1",
    "vite": "^8.1.1"
  }
}
